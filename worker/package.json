{
  "name": "tvbox-worker",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that serves TVBox configs, with an admin console.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.5"
  },
  "scripts": {
    "dev": "bun run --filter '@app/*' dev",
    "build": "bun run --filter '*' build",
    "lint": "eslint apps/ scripts/ tests/ eslint.config.ts --ext .ts,.tsx",
    "lint:fix": "eslint apps/ scripts/ tests/ eslint.config.ts --ext .ts,.tsx --fix",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "test:workers": "bun tests/workers/smoke.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run check:i18n && bun run check:env-docs && bun run check:api-docs",
    "check:i18n": "bun scripts/check-i18n.ts",
    "i18n:unused": "bun scripts/find-unused-i18n.ts",
    "i18n:clean": "bun scripts/clean-unused-i18n.ts",
    "check:env-docs": "bun scripts/gen-env-docs.ts --check",
    "check:api-docs": "bun run --filter @app/api check:api-docs",
    "gen:env-docs": "bun scripts/gen-env-docs.ts",
    "gen:api-docs": "bun run --filter @app/api gen:api-docs",
    "clean": "bun scripts/clean.ts",
    "clean:all": "bun scripts/clean.ts --all",
    "rebrand": "bun scripts/rebrand.ts",
    "hash-password": "bun scripts/hash-password.ts",
    "deploy": "bun run --filter @app/web build && bun run --filter @app/api workers:deploy",
    "tvbox:apply": "bun scripts/tvbox-apply.ts",
    "tvbox:health": "bun scripts/tvbox-health.ts",
    "media:import": "bun scripts/media-import-tmdb.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@app/tsconfig": "workspace:*",
    "@eslint-react/eslint-plugin": "5.28.8",
    "consola": "3.4.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "otpauth": "9.5.2",
    "typescript": "catalog:"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "undici": "^8.12.3"
  },
  "dependencies": {}
}
